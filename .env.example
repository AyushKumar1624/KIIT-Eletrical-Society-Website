# Join KES email verification. Copy to .env.local (never commit real values)
# and set the same variables in your hosting provider's settings.

# Required in production: 32+ random characters used to sign codes and tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOIN_SECRET=

# SMTP account that sends the one-time codes.
# Gmail / Google Workspace: smtp.gmail.com, port 465, the account address as
# SMTP_USER and a 16-character App Password (needs 2-Step Verification) as
# SMTP_PASS — never the account's normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
JOIN_EMAIL_FROM="KIIT Electrical Society <address@example.com>"
# Optional: where replies to the code email go.
JOIN_EMAIL_REPLY_TO=

# Required on serverless or multi-instance hosting (e.g. Vercel): a shared
# store for codes and rate limits. Leave empty for a single `next start` server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
