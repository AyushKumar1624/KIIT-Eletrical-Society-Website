# Copy to .env.local; never commit secrets. See docs/backend-phase-1.md.
# Node 22 or 24 recommended. Backend variables below are server-only.
MONGODB_URI=
MONGODB_DB=kes

# Exact comma-separated origins; production requires approved HTTPS origins.
# No paths, wildcards, query strings or credentials.
APP_ORIGINS=http://localhost:3110
ADMIN_RESET_ORIGIN=http://localhost:3110
# Generate TWO DIFFERENT random secrets, each at least 32 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
JOIN_SECRET=

# Authoritative OTP store: mongodb or upstash. Admins always use MongoDB.
# Production never falls back to memory.
JOIN_STORE=mongodb
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JOIN_DELIVERY=smtp

# Shared SMTP transport for OTPs and administrator recovery.
# Port 465: true. Port 587: false (STARTTLS is required).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
JOIN_EMAIL_FROM=
JOIN_EMAIL_REPLY_TO=

# Leave blank unless actually hosted on Vercel. Only vercel is supported,
# and the server additionally requires VERCEL=1. Do not set VERCEL manually.
# Other hosts ignore forwarded headers and share a conservative IP bucket
# until their trusted reverse-proxy boundary is implemented.
TRUST_PROXY=

# Approved public canonical address, when available.
NEXT_PUBLIC_SITE_URL=

# Explicit local development ONLY: JOIN_STORE=memory, JOIN_DELIVERY=console.
# Still requires JOIN_SECRET and APP_ORIGINS. Development OTPs are printed
# with recipients redacted. This never sends mail or enables admin recovery.
