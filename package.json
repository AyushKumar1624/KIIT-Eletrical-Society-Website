{
  "name": "kiit-electrical-society",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --test tests",
    "test:mongo": "node scripts/test-mongo.mjs",
    "env:check": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/check-env.mjs",
    "production:check": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/production-check.mjs",
    "production:init": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/production-init.mjs",
    "backend:setup": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/backend-setup.mjs",
    "admin:provision": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/provision-admin.mjs",
    "recruitment:cycle": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/recruitment-cycle.mjs",
    "jobs:process": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/process-jobs.mjs",
    "process-jobs": "npm run jobs:process",
    "content:migrate": "node --conditions=react-server --env-file-if-exists=.env.local scripts/operational/migrate-content.mjs",
    "migrate-content": "npm run content:migrate",
    "verify:all": "node --conditions=react-server --env-file-if-exists=.env.local scripts/verify/run-all.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "mongodb": "^7.7.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
